# Copy to .env.local. Everything is optional; the app runs fully in demo mode without any of these.

# SQLite file (default: ./data/app.db)
# DATABASE_PATH=./data/app.db

# Public URL, used in emails and OAuth callbacks
APP_URL=http://localhost:3000

# Comma-separated emails that get admin access. Required in production — there is no default admin.
# ADMIN_EMAILS=you@example.com

# The demo account (demo@opportunityhunter.app) has a published password, so it is seeded only outside
# production. Set this to run a public demo instance; it is never granted admin in production.
# SEED_DEMO=true

# Google login — create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email delivery. Without any of these, emails are logged to the server console.
#
# Option A — Gmail (free, no domain needed, reaches any recipient; best for launch).
# Turn on 2-Step Verification on the account, then create an App Password
# (https://myaccount.google.com/apppasswords) and paste the 16-char value below.
# GMAIL_USER=opportunityhunter.help@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
#
# Option B — Resend (https://resend.com). Only reaches your own inbox until you verify a domain
# and set EMAIL_FROM to an address on it.
# RESEND_API_KEY=
# EMAIL_FROM="Opportunity Hunter <hunter@yourdomain.com>"

# Live job listings via JSearch on RapidAPI (aggregates LinkedIn, Indeed, Glassdoor, employer sites).
# Subscribe (free tier available) at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch and paste your key.
# RAPIDAPI_KEY=
# Optional budget (defaults: 12h refresh, 180 calls/month ≈ RapidAPI free tier).
# POOL_REFRESH_HOURS=12
# RAPIDAPI_MONTHLY_CALLS=180

# Semantic matching (optional). Without a key, matching uses exact skill/role text only.
# With one, skills and roles are compared by meaning ("React" ≈ "Next.js") via Voyage embeddings,
# cached once per string in SQLite. Get a key at https://dashboard.voyageai.com.
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5-lite

# Resume PDF import (optional). Org-level keys also need ANTHROPIC_WORKSPACE_ID.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=

# Payments via Razorpay (https://razorpay.com). Without it, the upgrade flow shows a "not configured" panel.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Charge $10 outside India (requires Razorpay international and a country header such as cf-ipcountry).
# RAZORPAY_INTERNATIONAL=true

# Secret for the external cron endpoint POST /api/cron/hunt (in-process scheduler runs regardless)
# CRON_SECRET=
