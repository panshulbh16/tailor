# Copy to .env.local. Everything is optional except ANTHROPIC_API_KEY: without it the site runs, but tailoring is unavailable.

# SQLite file (default: ./data/app.db)
# DATABASE_PATH=./data/app.db

# Public URL, used in emails and OAuth callbacks
APP_URL=http://localhost:3000

# SEO: the canonical public origin, used for canonical tags, sitemap.xml, robots.txt and structured data.
# Defaults to https://tailor-production-6d17.up.railway.app. Read at build time, so redeploy after changing it.
# When you add a custom domain, set this (and APP_URL) to it.
# NEXT_PUBLIC_SITE_URL=https://tailor.example.com

# SEO: Google Search Console "HTML tag" verification. Paste the content="..." value (or the whole <meta> tag).
# This is public by design (it ends up in the page HTML), but keep it in host env vars, not in this file.
# GOOGLE_SITE_VERIFICATION=

# Comma-separated emails that get admin access. Required in production — there is no default admin.
# ADMIN_EMAILS=you@example.com

# Support address shown on /contact and on the manual password-reset fallback.
# SUPPORT_EMAIL=you@example.com

# Google login — create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email delivery (password resets). Without any of these, emails are logged to the server console.
#
# Option A — Gmail (free, no domain needed, reaches any recipient; best for launch).
# Turn on 2-Step Verification on the account, then create an App Password
# (https://myaccount.google.com/apppasswords) and paste the 16-char value below.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
#
# Option B — Resend (https://resend.com). Only reaches your own inbox until you verify a domain
# and set EMAIL_FROM to an address on it.
# RESEND_API_KEY=
# EMAIL_FROM="Tailor <tailor@yourdomain.com>"

# Claude — does the tailoring (required for it) and reads uploaded résumé PDFs.
# Org-level keys also need ANTHROPIC_WORKSPACE_ID.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=

# Payments via Razorpay (https://razorpay.com). Without it, Pro shows as "coming soon" and nobody is charged.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Charge $10 outside India (requires Razorpay international and a country header such as cf-ipcountry).
# RAZORPAY_INTERNATIONAL=true
